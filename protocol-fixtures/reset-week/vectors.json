{
  "rule": "The game week starts Monday 02:00:00 UTC. reset_week_start(ts) returns the most recent Monday 02:00 UTC at or before ts (boundary inclusive).",
  "consumers": [
    "supabase/tests/04_reset_week_test.sql (vectors inlined — keep in sync by hand until an automated check exists)",
    "services/collector (pytest, from P2)",
    "apps/dashboard (vitest, from P3)"
  ],
  "vectors": [
    {
      "name": "exact boundary is its own week start",
      "input": "2026-07-27T02:00:00Z",
      "expected": "2026-07-27T02:00:00Z"
    },
    {
      "name": "one second before boundary belongs to previous week",
      "input": "2026-07-27T01:59:59Z",
      "expected": "2026-07-20T02:00:00Z"
    },
    {
      "name": "midweek",
      "input": "2026-07-28T12:34:56Z",
      "expected": "2026-07-27T02:00:00Z"
    },
    {
      "name": "sunday end of week",
      "input": "2026-08-02T23:59:59Z",
      "expected": "2026-07-27T02:00:00Z"
    },
    {
      "name": "year boundary",
      "input": "2026-01-01T00:30:00Z",
      "expected": "2025-12-29T02:00:00Z"
    },
    {
      "name": "monday before 02:00 near year end",
      "input": "2026-12-28T01:00:00Z",
      "expected": "2026-12-21T02:00:00Z"
    },
    {
      "name": "non-UTC offset input normalizes to UTC",
      "input": "2026-07-27T11:00:00+09:00",
      "expected": "2026-07-27T02:00:00Z"
    }
  ]
}
