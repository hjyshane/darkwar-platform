# ---------------------------------------------------------------------------
# Capture and game data — NEVER commit.
# Login PCAPs contain the collector account's UID and session signature
# (spec 5.2, Appendix A darkwar_loading.pcapng). Once in history, it is
# permanent even in a private repo.
# Raw captures and databases live OUTSIDE this repo, in a sibling directory.
# ---------------------------------------------------------------------------
*.pcap
*.pcapng
*.cap
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
legacy/**/data/
legacy/**/*.db

# ---------------------------------------------------------------------------
# Secrets. The Supabase secret/service-role key bypasses RLS entirely (NFR-001)
# and belongs only in collector env vars and GitHub Actions secrets.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# Windows collector env script (copy of dw-env.example.ps1 with real paths)
dw-env.ps1

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
# PyInstaller regenerates this on every build-console.ps1 run.
*.spec

# ---------------------------------------------------------------------------
# Node / TypeScript
# ---------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Supabase local stack
# ---------------------------------------------------------------------------
.supabase/
supabase/.branches/
supabase/.temp/

# ---------------------------------------------------------------------------
# Claude Code — .claude/settings.json is shared, .local.json is per-machine
# ---------------------------------------------------------------------------
.claude/settings.local.json
# Worktrees live under the repo, so `git add -A` from the main checkout stages
# them as embedded git repositories. Caught once; ignore them instead.
.claude/worktrees/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Agent session logs — local notes, not repo history.
.claude/logs/

# `wrangler dev` writes miniflare state and a bundled copy of the Worker here.
# Untracked it is merely noise; unignored it also breaks `pnpm check`, because
# biome lints the generated bundle and finds two dozen violations in code
# nobody wrote. Both apps with a wrangler.jsonc produce one.
.wrangler/
