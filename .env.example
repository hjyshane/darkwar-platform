# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# The collector loads this file automatically: `dw-collector`, `dw-capture`,
# and `dw-sync` look for $DW_ENV_FILE, else the nearest .env at or above the
# working directory (so running from services/collector finds a repo-root
# .env). Variables already set in the shell always win, so dw-env.ps1 and CI
# secrets override a stale file.
#
# Key discipline (spec NFR-001, 10.4):
#   - The PUBLISHABLE key is safe in the browser bundle. RLS still applies.
#   - The SECRET (service-role) key BYPASSES RLS ENTIRELY. It belongs only in
#     the collector process env and GitHub Actions secrets. Never in VITE_*,
#     never in anything the browser downloads.

# --- Supabase (local stack defaults from `supabase start`) ------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# --- Dashboard (Vite: every VITE_* var is embedded in the browser bundle) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_DISCORD_CLIENT_ID=

# --- Collector identity ------------------------------------------------------
# Which server the collector ACCOUNT plays on. Distinct from the server_id of
# any given observed player: a server.rank response from 580 carries players
# from the whole 577-584 group (spec 11.2, "provenance vs subject").
DW_COLLECTOR_ID=
DW_COLLECTOR_SERVER_ID=580
DW_SQLITE_PATH=./data/collector.db

# --- Capture (Windows only; requires `uv sync --extra capture` + Npcap) -----
DW_CAPTURE_INTERFACE=
DW_CAPTURE_PORT=8680

# --- ADB / BlueStacks --------------------------------------------------------
# FR-COL-001 / FR-COL-010: automation may control ONLY the collector instance.
# The denylist is a hard guard against ever touching the main account's
# instance. Both must be set before any UI automation runs.
DW_ADB_COLLECTOR_SERIAL=
DW_ADB_DENYLIST_SERIALS=
